# Copy to .env.local and fill in. Never commit real keys.

# Gemini (server only). Empty = the chatbot answers from prepared text ("demo mode").
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash-lite; other models are tried if it fails.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated emails that get the admin role (post urgent alerts, manage reports).
# The person must register on the site with the same email.
ADMIN_EMAILS=

# Database. Locally a file is used: ./data/smart-orkhon.db (override with DB_PATH).
# In production (Vercel) use a free Turso database instead — see DEPLOY.md.
# DB_PATH=
# TURSO_DATABASE_URL=libsql://<db-name>-<user>.turso.io
# TURSO_AUTH_TOKEN=

# Public site address (QR code in the app section). Default https://smart-orkhon.vercel.app
# NEXT_PUBLIC_SITE_URL=
# Contact email shown on /privacy.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Android app (Trusted Web Activity) — served at /.well-known/assetlinks.json. See android/README.md.
# ANDROID_PACKAGE_ID=mn.smartorkhon.app
# ANDROID_SHA256_FINGERPRINTS=

# Traffic is not stored: it is read live from the camera centre and refreshed every 5 minutes.
